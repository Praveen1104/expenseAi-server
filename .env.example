PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/smartspend_prod
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CORS_ORIGIN=http://localhost:3000
OPENAI_API_KEY=your-openai-api-key-here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JWT_ACCESS_SECRET=your-jwt-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-minimum-32-chars-long
STORAGE_DIR=uploads
RUN_WORKER=false
LOG_LEVEL=info
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name-here
